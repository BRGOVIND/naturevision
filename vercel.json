{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "queue_worker": {
      "root": "queue-worker/",
      "entrypoint": "api/analysis.js",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "NATUREVISION_BACKEND_URL"
        }
      ],
      "functions": {
        "api/analysis.js": {
          "maxDuration": 300,
          "experimentalTriggers": [
            { "type": "queue/v2beta", "topic": "naturevision-analysis" }
          ]
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
