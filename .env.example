# NatureVision configuration.
# Copy to .env and adjust. Never commit a filled-in .env.

# --- application ---------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# console | json  (use json in deployed environments)
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- database ------------------------------------------------------------
# PostgreSQL + PostGIS is the deployment target and what docker compose runs.
DATABASE_URL=postgresql+asyncpg://naturevision:naturevision@localhost:5432/naturevision
# For local development without Docker, SQLite works for everything except
# PostGIS spatial queries:
# DATABASE_URL=sqlite+aiosqlite:///./naturevision.db
POSTGRES_USER=naturevision
POSTGRES_PASSWORD=naturevision
POSTGRES_DB=naturevision
POSTGRES_PORT=5432
DB_ECHO=false

# --- satellite imagery ----------------------------------------------------
# Element84 Earth Search: a public STAC API over the AWS Open Data mirror of
# Sentinel-2 Level-2A. No account or key is required.
STAC_ENDPOINT=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a
STAC_TIMEOUT_SECONDS=60
STAC_MAX_RETRIES=4
STAC_MAX_CONCURRENT_REQUESTS=4
MAX_CLOUD_COVER_PERCENT=40
MAX_SEARCH_RESULTS=50

# --- raster processing ------------------------------------------------------
# Longest edge of the analysis grid, in pixels. Higher means finer detail and
# slower analysis; the region extent is unaffected.
TARGET_RASTER_MAX_DIM=768
MAX_REGION_AREA_KM2=2500
MIN_REGION_AREA_KM2=0.01

# --- change detection ---------------------------------------------------------
# Absolute NDVI units. Reported with every result so readers can re-derive the
# change classes. See docs/methodology.md for how these were chosen.
CHANGE_MODERATE_THRESHOLD=0.10
CHANGE_SIGNIFICANT_THRESHOLD=0.20

# --- machine learning ------------------------------------------------------------
# random_forest | torch_mlp
LAND_COVER_BACKEND=random_forest
# MODEL_DIR=./artifacts/models

# --- language interpretation --------------------------------------------------------
# Optional. Without a key the analysis runs in full and the report is generated
# with the interpretation section explicitly marked unavailable.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LANGUAGE_MODEL=llama-3.3-70b-versatile
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LANGUAGE_TEMPERATURE=0.2
LANGUAGE_MAX_TOKENS=2000
ENABLE_VISION_INTERPRETATION=true

# --- ports (docker compose) -----------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080
