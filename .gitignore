# Trained models are large binaries; the manifest and metrics are kept so the
# model's provenance and measured accuracy stay in version control.
backend/artifacts/models/**/model.joblib
backend/artifacts/models/**/model.pt

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Research artifacts.
# The pixel cache is rebuildable from the manifest and is far too large to
# track; manifests, tables, figures and experiment records are kept so results
# stay traceable without committing raster data.
backend/research/cache/
backend/research/results/**/predictions_*.csv
